{
  "name": "flaptap",
  "version": "1.0.0",
  "description": "Flaptap AI - Autonomous AI-Driven American Accent, Prosody & Verbatim Shadowing Studio",
  "author": "abdallahaladl",
  "private": true,
  "scripts": {
    "dev": "cd backend && npm run start",
    "build": "cd backend && npm run build",
    "start": "cd backend && npm run start:prod",
    "prod:start": "./scripts/daemon_manager.sh start",
    "prod:stop": "./scripts/daemon_manager.sh stop",
    "prod:restart": "./scripts/daemon_manager.sh restart",
    "prod:status": "./scripts/daemon_manager.sh status",
    "prod:url": "./scripts/daemon_manager.sh url",
    "domain:connect": "./scripts/setup_custom_domain.sh",
    "deploy": "./scripts/deploy.sh",
    "test:e2e": "NODE_PATH=./node_modules node scripts/test_production_e2e.js",
    "migrate:timings": "NODE_PATH=./node_modules node scripts/migrate_timings.js",
    "test:timing": "python3 scripts/test_timing_extractor.py"
  },
  "devDependencies": {
    "puppeteer": "^25.16.0"
  }
}
