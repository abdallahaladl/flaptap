# =============================================================================
# Flaptap AI — Production Environment Configuration (.env)
# =============================================================================

# Public domain name for automated HTTPS / Let's Encrypt certificates via Caddy
# Set this to your actual public domain or subdomain (e.g. flaptap.yourdomain.com)
DOMAIN=flaptap.example.com

# Server & Runtime Configuration
PORT=3333
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*
TRUST_PROXY=1

# Relational Database Storage Path (Node 22 built-in SQLite WAL Engine)
# In Docker, this must point inside the mounted volume directory:
FLAPTAP_SQLITE_PATH=/app/data/flaptap.sqlite

# -----------------------------------------------------------------------------
# AI Transport — OpenCode Go (Universal Cognitive American Accent Engine)
# -----------------------------------------------------------------------------
# Obtain your API key from https://opencode.ai/console
OPENCODE_GO_API_KEY=your_opencode_go_api_key_here
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# -----------------------------------------------------------------------------
# Google OAuth 2.0 + OIDC Sign-In (Optional - Email/Password always enabled)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Web Client credentials in Google Cloud Console:
# 1. Authorized JavaScript origins:  https://flaptap.example.com
# 2. Authorized redirect URI:        https://flaptap.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://flaptap.example.com/api/auth/google/callback

# -----------------------------------------------------------------------------
# YouTube Subtitle Ingestion Settings (Optional Cloud Guardrails)
# -----------------------------------------------------------------------------
# Optional proxy URL if your cloud provider's datacenter IP is throttled by YouTube:
# HTTP_PROXY=http://user:pass@proxy-server:port
# HTTPS_PROXY=http://user:pass@proxy-server:port
