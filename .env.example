# =============================================================================
# Flaptap AI — Production Environment Configuration
# =============================================================================

# Server Configuration
PORT=3333
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# AI transport — OpenCode Go (OpenAI-compatible endpoint)
# Get a key from https://opencode.ai/console and keep it in .env only.
OPENCODE_GO_API_KEY=your_opencode_go_api_key_here
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Google OAuth 2.0 + OIDC Sign-In (Google Cloud Console -> OAuth 2.0 Web Client)
# Authorized JavaScript Origin: http://localhost:3333
# Authorized Redirect URI:      http://localhost:3333/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional explicit redirect override behind reverse proxies:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Subtitle Audio Ingestion Script Path (Optional - auto-discovered by default)
# SKILL_SCRIPT_PATH=skills/american-accent-shadowing-skill/scripts/extract_transcript.py
